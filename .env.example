# Copy this file to .env.local and fill in real values from the Firebase
# Console / Google Cloud Console. Never commit .env.local — see .gitignore.

# --- Server-side only (secret — never expose to the browser) ---

# OPTIONAL. Leave this blank and use Application Default Credentials instead:
#
#   gcloud auth application-default login
#
# That is the preferred setup. It needs no key file, the credentials are
# short-lived and revocable, and deployed on Cloud Functions/Cloud Run it
# resolves automatically from the runtime service account — nothing to set.
# It is also the only option that works when the GCP organization enforces
# `constraints/iam.disableServiceAccountKeyCreation` (the default for orgs
# created since mid-2024), which makes "Generate new private key" fail with
# "Key creation is not allowed on this service account."
#
# If you do use a key: Firebase Console > Project Settings > Service Accounts >
# Generate new private key, then paste the downloaded JSON here as a single
# line WRAPPED IN SINGLE QUOTES — with double quotes, dotenv expands the \n
# inside private_key into real newlines and JSON.parse then rejects it.
#   FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Client-side (public — safe to expose, these are not secrets in
# Firebase's security model; access control is via Firestore/Storage
# rules and the server-side auth check, not by hiding these values) ---

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Workspace domain allowed to sign in to this admin (WEB_ADMIN.md §4).
# Defaults to thaishieldapp.com in code if unset — only set this to override.
NEXT_PUBLIC_ADMIN_ALLOWED_DOMAIN=thaishieldapp.com

# Google Maps JavaScript API key, used by the alert_zones polygon editor
# (WEB_ADMIN.md §3/§8 step 4). Restrict this key to this admin's domain(s)
# in Google Cloud Console > Credentials.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
