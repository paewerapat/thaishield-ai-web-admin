# Copy this file to .env.local and fill in real values from the Firebase
# Console / Google Cloud Console. Never commit .env.local — see .gitignore.

# --- Server-side only (secret — never expose to the browser) ---

# Full service account key JSON, downloaded from Firebase Console >
# Project Settings > Service Accounts > Generate new private key.
# Paste it as a single-line JSON string (escape newlines as \n inside
# private_key, which the downloaded file already does).
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Client-side (public — safe to expose, these are not secrets in
# Firebase's security model; access control is via Firestore/Storage
# rules and the server-side auth check, not by hiding these values) ---

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Workspace domain allowed to sign in to this admin (WEB_ADMIN.md §4).
# Defaults to thaishieldapp.com in code if unset — only set this to override.
NEXT_PUBLIC_ADMIN_ALLOWED_DOMAIN=thaishieldapp.com

# Google Maps JavaScript API key, used by the alert_zones polygon editor
# (WEB_ADMIN.md §3/§8 step 4). Restrict this key to this admin's domain(s)
# in Google Cloud Console > Credentials.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
